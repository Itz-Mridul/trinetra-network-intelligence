        "textMode": "auto"
      },
      "title": "Active Ground Truth Class",
      "type": "stat",
      "targets": [
        {
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"network_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"gw_loss_pct\")\n  |> keep(columns: [\"fault_class\"])\n  |> last()"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB_v2" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "title": "Cross-Layer RTT Comparison (Pi Wired vs ESP32 Wi-Fi)",
      "type": "timeseries",
      "targets": [
        {
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"network_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"inet_rtt_mean_ms\" or r[\"_field\"] == \"gw_rtt_mean_ms\")\n  |> aggregateWindow(every: 5s, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB_v2" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -75 },
              { "color": "green", "value": -65 }
            ]
          },
          "unit": "dBm"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "ESP32 Wi-Fi Signal Strength (RSSI)",
      "type": "timeseries",
      "targets": [
        {
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"network_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"rssi_calibrated_dbm\" or r[\"_field\"] == \"rssi_raw_dbm\")\n  |> aggregateWindow(every: 5s, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "datasource": { "type": "influxdb", "uid": "InfluxDB_v2" },
